        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; ====== ERD: Airline Reservation System ======\n\nentity Users {\n  +id : INT &lt;&lt;PK&gt;&gt;\n  --\n  role : VARCHAR(50)\n  email : VARCHAR(100)\n  password : VARCHAR(255)\n  first_name : VARCHAR(50)\n  last_name : VARCHAR(50)\n  phone : VARCHAR(20)\n  address : VARCHAR(255)\n  zip : VARCHAR(10)\n  city : VARCHAR(50)\n  state : VARCHAR(50)\n  country : VARCHAR(50)\n  gender : VARCHAR(10)\n  age : INT\n}\n\nentity Flights {\n  +id : INT &lt;&lt;PK&gt;&gt;\n  --\n  flight_name : VARCHAR(100)\n  source : VARCHAR(100)\n  destination : VARCHAR(100)\n  date : DATE\n  time : TIME\n  business_seat : INT\n  economy_seat : INT\n  bag_number : INT\n}\n\nentity Airport {\n  +id : INT &lt;&lt;PK&gt;&gt;\n  --\n  airport_name : VARCHAR(100)\n  price : INT\n}\n\nentity UserFlights {\n  +id : INT &lt;&lt;PK&gt;&gt;\n  --\n  user_id : INT &lt;&lt;FK&gt;&gt;\n  flight_id : INT &lt;&lt;FK&gt;&gt;\n  business_seat : INT\n  economy_seat : INT\n  bag_number : INT\n  price : INT\n}\n\nentity FlightAirports {\n  +flight_id : INT &lt;&lt;PK, FK&gt;&gt;\n  +airport_id : INT &lt;&lt;PK, FK&gt;&gt;\n}\n\n&#39; ====== Relationships ======\n\nUsers ||--o{ UserFlights : books\nFlights ||--o{ UserFlights : includes\n\nFlights ||--o{ FlightAirports : passes_through\nAirport ||--o{ FlightAirports : serves\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="yQKpqZ4BgcLZCRkraYQH-1">
